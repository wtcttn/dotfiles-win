// Tailscale の tailnet のポリシー（ACL）。反映は tailscale/apply-policy.ps1 で行う。
// このリポジトリは公開なので、IP、tailnet 名、メールアドレス、ログイン名は書かない。
// 見せたくない値は ${名前} の印にし、apply-policy.ps1 が tailscale/secrets.bw に従って Bitwarden から埋める。
//
// Grok Bot の箱は、Grok Bot のコネクタで、箱専用の利用者としてつなぐ。
// コネクタの端末に札（tag）を付けると接続が切れるので、札ではなく利用者で絞る（2026-11-12 に確かめた）。
// autogroup:member を使うと箱専用の利用者も当てはまるので、使わない。
{
	"hosts": {
		"sugimoto-pc": "${TS_HOST_SUGIMOTO_PC}",
	},

	"grants": [
		// オーナー本人の端末からは、全部届く。
		{"src": ["${TS_USER_OWNER}"], "dst": ["*"], "ip": ["*"]},
	],

	// Tailscale SSH は、オーナー本人が自分の端末にだけ（確認つき）。
	"ssh": [
		{
			"action": "check",
			"src":    ["${TS_USER_OWNER}"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
