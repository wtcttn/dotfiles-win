# apply-policy.ps1 が Bitwarden から読む値。1行は「名前=Bitwarden の項目名」で、項目のパスワード欄を読む。
# 「名前=項目名:username」と書くと、ユーザー名欄を読む。値はここに書かない。
#
# Tailscale の API の鍵（管理画面の Settings → OAuth clients で作る。権限は Policy File の書き込みだけ）
TS_OAUTH_CLIENT_ID=tailscale-policy-oauth:username
TS_OAUTH_CLIENT_SECRET=tailscale-policy-oauth
# policy.hujson の印に埋める値
TS_HOST_SUGIMOTO_PC=tailscale-host-sugimoto-pc
