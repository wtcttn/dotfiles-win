// PowerShell 起動時の表示。wslc-dev/home/.config/fastfetch と同じ見た目で、中身は Windows 向け。
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$3 ✧          $3✦\n$1    /\\_/\\\n$1   ( $5•ω•$1 )   $3✧\n$1   /  $2♡$1  \\\n$3 ✦ $1(_)-(_)\n\n$4    pwsh",
    "color": {
      "1": "38;2;245;168;214",
      "2": "38;2;255;143;177",
      "3": "38;2;255;240;179",
      "4": "38;2;201;182;255",
      "5": "38;2;168;216;255"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "output": "38;2;232;222;245"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;245;168;214",
        "at": "38;2;185;163;232",
        "host": "38;2;168;216;255"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;138;118;184m·  ·  ✦  ·  ·  ·  ✧  ·  ·"
    },
    { "type": "os", "key": " os", "keyColor": "38;2;245;168;214" },
    { "type": "uptime", "key": "󰅐 uptime", "keyColor": "38;2;168;216;255" },
    { "type": "shell", "key": " shell", "keyColor": "38;2;255;240;179" },
    { "type": "terminal", "key": " term", "keyColor": "38;2;168;236;216" },
    { "type": "cpu", "key": " cpu", "keyColor": "38;2;255;201;176" },
    { "type": "gpu", "key": "󰢮 gpu", "keyColor": "38;2;201;182;255" },
    { "type": "memory", "key": "󰍛 memory", "keyColor": "38;2;245;168;214" },
    { "type": "disk", "key": "󰋊 disk", "keyColor": "38;2;168;216;255", "folders": "C:\\" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
