{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "pink": "#f5a8d6",
    "lavender": "#c9b6ff",
    "sky": "#a8d8ff",
    "mint": "#a8ecd8",
    "cream": "#fff0b3",
    "peach": "#ffc9b0",
    "rose": "#ff8fb1",
    "plum": "#3a2440",
    "frame": "#b9a3e8"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:pink",
          "foreground": "p:plum",
          "leading_diamond": "<p:frame,transparent>\u256d\u2500</>\ue0b6",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "p:lavender",
          "foreground": "p:plum",
          "powerline_symbol": "\ue0b4",
          "properties": {
            "home_icon": "~",
            "style": "full"
          },
          "style": "powerline",
          "template": " \uf07c {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "p:mint",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:cream{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:rose{{ end }}",
            "{{ if gt .Ahead 0 }}p:sky{{ end }}",
            "{{ if gt .Behind 0 }}p:peach{{ end }}"
          ],
          "foreground": "p:plum",
          "powerline_symbol": "\ue0b4",
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "p:mint",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \ue718 ",
          "type": "node"
        },
        {
          "background": "p:sky",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue627 ",
          "type": "go"
        },
        {
          "background": "p:lavender",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue624 ",
          "type": "julia"
        },
        {
          "background": "p:cream",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue235 ",
          "type": "python"
        },
        {
          "background": "p:rose",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "display_mode": "files",
            "fetch_version": true
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue791 ",
          "type": "ruby"
        },
        {
          "background": "p:peach",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "display_mode": "files",
            "fetch_version": true
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue7a8 ",
          "type": "rust"
        },
        {
          "background": "p:cream",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "display_mode": "files",
            "fetch_version": false
          },
          "style": "powerline",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uf0e7",
          "type": "azfunc"
        },
        {
          "background": "p:peach",
          "background_templates": [
            "{{if contains \"jan\" .Profile}}p:rose{{end}}"
          ],
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "display_default": false
          },
          "style": "powerline",
          "template": " {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} \ue7ad ",
          "type": "aws"
        },
        {
          "background": "p:rose",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "style": "powerline",
          "template": " \uf0ad ",
          "type": "root"
        },
        {
          "background": "p:cream",
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "style": "powerline",
          "template": " {{ .FormattedMs }} \uf252 ",
          "type": "executiontime"
        },
        {
          "background": "p:mint",
          "background_templates": [
            "{{ if gt .Code 0 }}p:rose{{ end }}"
          ],
          "foreground": "p:plum",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b6",
          "properties": {
            "always_enabled": true
          },
          "style": "powerline",
          "template": " {{ if gt .Code 0 }}\u2718 {{ reason .Code }}{{ else }}\u2661{{ end }} ",
          "type": "status"
        },
        {
          "background": "p:sky",
          "foreground": "p:plum",
          "invert_powerline": true,
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} \uf186 ",
          "trailing_diamond": "\ue0b4<p:frame,transparent>\u2500\u256e</>",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:frame",
          "style": "plain",
          "template": "\u2570\u2500<p:pink>\u2726</>",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "foreground": "p:frame",
          "style": "plain",
          "template": "\u2500\u256f",
          "type": "text"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "♡ {{ .Folder }}",
  "final_space": true,
  "version": 3
}
