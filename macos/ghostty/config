# Mac の Ghostty。色・フォント・透過は archlinux/.config/ghostty/config に合わせる。
# GTK 専用の項目と Linux のキー割り当ては入れない。macOS の既定（Cmd+T / Cmd+C など）を使う。
# 反映は Cmd+Shift+,。フォントを初めて読むときは再起動。

font-family = Moralerspace Neon HWJPDOC
font-size = 13

background-opacity = 0.7
background-blur = 10
background = #1e1e2e
foreground = #cdd6f4

cursor-color = #89b4fa
cursor-text = #1e1e2e
cursor-style = block
cursor-style-blink = true

window-padding-x = 4
window-padding-y = 4

# Black
palette = 0=#45475a
palette = 8=#585b70
# Red
palette = 1=#f38ba8
palette = 9=#f38ba8
# Green
palette = 2=#a6e3a1
palette = 10=#a6e3a1
# Yellow
palette = 3=#f9e2af
palette = 11=#f9e2af
# Blue
palette = 4=#89b4fa
palette = 12=#89b4fa
# Magenta
palette = 5=#f5c2e7
palette = 13=#f5c2e7
# Cyan
palette = 6=#94e2d5
palette = 14=#94e2d5
# White
palette = 7=#bac2de
palette = 15=#cdd6f4

unfocused-split-opacity = 0.8

# Option を Alt として Neovim に渡す。
macos-option-as-alt = true

# Neovim の OSC 52 を確認なしで受け付ける。普段のクリップボードは macOS 側。
clipboard-read = allow
clipboard-write = allow
