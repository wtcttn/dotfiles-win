{
  "mcpServers": {
    "bitwarden": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@bitwarden/mcp-server@2026.7.0"],
      "env": {
        "BW_SESSION": "${BW_SESSION}"
      }
    },
    "hub-bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["${USERPROFILE}/dotfiles/claude/bridge/server.mjs"],
      "env": {
        "HUB_BRIDGE_TOKEN": "${HUB_BRIDGE_TOKEN:-}",
        "GROKBOT_WEBHOOK_URL": "${GROKBOT_WEBHOOK_URL:-}",
        "GROKBOT_WEBHOOK_KEY": "${GROKBOT_WEBHOOK_KEY:-}",
        "GROKBOT_WEBHOOK_HEADER": "${GROKBOT_WEBHOOK_HEADER:-}"
      }
    }
  }
}
